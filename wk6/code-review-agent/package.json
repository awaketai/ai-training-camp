{
  "name": "code-review-agent",
  "version": "1.0.0",
  "description": "A code review agent built on Simple Agent SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "example:branch": "npx tsx examples/review-branch.ts",
    "example:commit": "npx tsx examples/review-commit.ts",
    "example:pr": "npx tsx examples/review-pr.ts"
  },
  "dependencies": {
    "simple-agent": "file:../simple-agent"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
