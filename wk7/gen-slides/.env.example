# GenSlides Configuration

# Image Generation Provider
# Options: "gemini" or "qianwen"
IMAGE_GENERATOR_TYPE=gemini

# Gemini Settings
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp-image-generation

# Qianwen (通义千问) Settings
QIANWEN_API_KEY=your-qianwen-api-key-here
QIANWEN_IMAGE_MODEL=wanx-v1

# Server Settings
HOST=0.0.0.0
PORT=8000
SLIDES_DIR=./slides
